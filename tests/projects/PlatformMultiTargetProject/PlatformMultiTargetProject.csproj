<Project Sdk="Microsoft.NET.Sdk">

  <!-- Two target frameworks that differ only by platform share a TargetFrameworkMoniker
       (.NETCoreApp,Version=v8.0), so each compiles a different source file: a result that ends up with
       both, or a framework that goes missing, means the two inner builds were merged into one. -->

  <PropertyGroup>
    <TargetFrameworks>net8.0;net8.0-windows</TargetFrameworks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup Condition=" '$(TargetFramework)' == 'net8.0' ">
    <Compile Include="PortableOnly.cs" />
  </ItemGroup>

  <ItemGroup Condition=" '$(TargetFramework)' == 'net8.0-windows' ">
    <Compile Include="WindowsOnly.cs" />
  </ItemGroup>

</Project>
